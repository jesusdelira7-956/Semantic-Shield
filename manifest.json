{
  "manifest_version": 3,
  "name": "Semantic Shield",
  "version": "2.0.0",
  "description": "Sovereign ad, tracker & Local LLM loopback firewall with semantic AI sludge filter, live logger, and self-healing element picker.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_local_llm",
        "enabled": true,
        "path": "rules/local_llm_shield.json"
      },
      {
        "id": "ruleset_core_ads",
        "enabled": true,
        "path": "rules/core_ad_shield.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Semantic Shield"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/semantic_heuristics.js",
        "content/element_picker.js",
        "content/content_shield.js"
      ],
      "run_at": "document_start"
    }
  ]
}
